# ==============================================================================
# UZHAVAN HUB (உழவன் ஹப்) — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Relational Database Configuration
# ------------------------------------------------------------------------------
# Primary: PostgreSQL connection URL (e.g. postgresql://user:password@localhost:5432/uzhavan_db)
# Autonomous Fallback: If DATABASE_URL is unset or Postgres is unreachable,
# the backend automatically boots with native node:sqlite (uzhavan.db) with
# zero npm dependencies required.
DATABASE_URL=

# ------------------------------------------------------------------------------
# Authentication & Session Security
# ------------------------------------------------------------------------------
# 32-character secret key for signing session tokens and cookies
SESSION_SECRET=uzhavan_hub_super_secret_session_key_32_chars_2026

# Seed Demo Farmers (Murugan P. from Madurai, Anitha R. from Thanjavur, Selvam V.)
DEMO_MODE=true

# ------------------------------------------------------------------------------
# External API Providers (Optional — Full Offline Fallbacks Built-in)
# ------------------------------------------------------------------------------
# 1. Weather Data Provider (OpenWeatherMap / IMD Agri-Meteorological Division)
# Fallback: Hyperlocal 38-district monsoon forecast dataset in data/sample_weather.json
WEATHER_API_KEY=

# 2. Market Prices Provider (Agmarknet / TN Regulated Market Committees)
# Fallback: Daily spot benchmark dataset in data/sample_market_prices.json
MARKET_API_KEY=

# 3. Advanced Conversational AI Engine (Google Gemini / Vertex AI)
# Fallback: Deterministic Tamil-English rule-based agricultural advisory engine
GEMINI_API_KEY=
