    "test": "node tests/test_api_endpoints.js",
    "test:datasets": "python tests/test_json_datasets.py",
    "test:all": "python tests/test_json_datasets.py && node tests/test_api_endpoints.js"
  },
  "keywords": [
    "agriculture",
    "smart-farming",
    "tamil-nadu",
    "crop-advisor",
    "decision-engine",
    "mandi-prices",
