{
  "name": "uzhavan-hub",
  "version": "2.0.0",
  "description": "Uzhavan Hub (உழவன் ஹப்) — Complete AI-Powered Smart Agriculture Platform for Tamil Nadu Farmers",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "node server/server.js",
